# Terraform state — store in remote backend, never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files — may contain sensitive values
*.tfplan
*.out

# Variable files — may contain subscription IDs, subnet IDs, and secrets.
# Keep example files (.tfvars.example) in source control.
# Copy to .tfvars locally; never commit the real values.
terraform.tfvars
environments/*.tfvars

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Crash log
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
